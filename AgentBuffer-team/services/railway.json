{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/Dockerfile"
  },
  "deploy": {
    "startCommand": "uv run python -m services.cognition.bureau",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
